{
  "name": "typewriter-teardown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D teardown simulator of an Underwood No. 5 typewriter, driven by one deterministic machine model.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test \"tests/model/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/acceptance.mjs",
    "test:acceptance": "node tests/e2e/acceptance.mjs",
    "validate": "node scripts/build.mjs && node scripts/validate.mjs && node scripts/views.mjs",
    "stills": "node scripts/capture.mjs --stills beats",
    "sheet": "node scripts/capture.mjs --stills beats --sheet validation/contact-sheet.png",
    "scrub": "node scripts/capture.mjs --stills every:0.2",
    "video": "node scripts/video.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "esbuild": "0.28.1",
    "playwright": "1.58.2"
  }
}
